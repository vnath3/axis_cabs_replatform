<section class="sec routes-sec" id="routes">
  <div class="sec-wrap">
    <div class="routes-header">
      <div>
        <div class="kicker">Popular routes</div>
        <div class="h2">Fixed fares — no negotiation</div>
      </div>
      <a class="see-all" onclick="gate('out')">All 500+ routes →</a>
    </div>
    <div class="routes-featured">
      <div class="route featured" onclick="gate('out')"><div class="r-left"><div class="r-cities">Pune <span class="r-arrow">→</span> Shirdi</div><div class="r-meta">190 km · ~3.5 hrs · Sedan or SUV</div></div><div class="r-right"><div class="r-fare">from ₹2,800</div><div class="r-note">one way</div></div></div>
      <div class="route featured" onclick="gate('out')"><div class="r-left"><div class="r-cities">Pune <span class="r-arrow">→</span> Aurangabad</div><div class="r-meta">235 km · ~4.5 hrs</div></div><div class="r-right"><div class="r-fare">from ₹3,400</div><div class="r-note">one way</div></div></div>
      <div class="route featured" onclick="gate('out')"><div class="r-left"><div class="r-cities">Mumbai <span class="r-arrow">→</span> Pune</div><div class="r-meta">150 km · ~3 hrs · Expressway</div></div><div class="r-right"><div class="r-fare">from ₹2,200</div><div class="r-note">one way</div></div></div>
      <div class="route featured" onclick="gate('out')"><div class="r-left"><div class="r-cities">Aurangabad <span class="r-arrow">→</span> Shirdi</div><div class="r-meta">130 km · ~2.5 hrs</div></div><div class="r-right"><div class="r-fare">from ₹1,900</div><div class="r-note">one way</div></div></div>
    </div>
    <div class="routes-divider"><div class="routes-divider-line"></div><span class="routes-divider-text">More routes</span><div class="routes-divider-line"></div></div>
    <div class="routes-standard">
      <div class="route" onclick="gate('out')"><div class="r-left"><div class="r-cities">Pune <span class="r-arrow">→</span> Nashik</div><div class="r-meta">210 km · ~4 hrs</div></div><div class="r-right"><div class="r-fare">from ₹3,000</div><div class="r-note">one way</div></div></div>
      <div class="route" onclick="gate('out')"><div class="r-left"><div class="r-cities">Mumbai <span class="r-arrow">→</span> Goa</div><div class="r-meta">590 km · ~9 hrs</div></div><div class="r-right"><div class="r-fare">from ₹7,500</div><div class="r-note">one way</div></div></div>
      <div class="route" onclick="gate('out')"><div class="r-left"><div class="r-cities">Pune <span class="r-arrow">→</span> Mahabaleshwar</div><div class="r-meta">120 km · ~2.5 hrs</div></div><div class="r-right"><div class="r-fare">from ₹1,800</div><div class="r-note">one way</div></div></div>
      <div class="route" onclick="gate('out')"><div class="r-left"><div class="r-cities">Aurangabad <span class="r-arrow">→</span> Ajanta</div><div class="r-meta">100 km · ~2 hrs</div></div><div class="r-right"><div class="r-fare">from ₹1,500</div><div class="r-note">one way</div></div></div>
      <div class="route" onclick="gate('out')"><div class="r-left"><div class="r-cities">Nagpur <span class="r-arrow">→</span> Aurangabad</div><div class="r-meta">380 km · ~6 hrs</div></div><div class="r-right"><div class="r-fare">from ₹5,200</div><div class="r-note">one way</div></div></div>
      <div class="route" onclick="gate('out')"><div class="r-left"><div class="r-cities">Pune <span class="r-arrow">→</span> Kolhapur</div><div class="r-meta">228 km · ~4.5 hrs</div></div><div class="r-right"><div class="r-fare">from ₹3,200</div><div class="r-note">one way</div></div></div>
    </div>
  </div>
</section>

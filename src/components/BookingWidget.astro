---
---
<div class="widget">
  <div class="wtabs">
    <button class="wtab on" onclick="tab('out',this)"><span class="wtab-icon">🛣️</span>Outstation</button>
    <button class="wtab" onclick="tab('air',this)"><span class="wtab-icon">✈️</span>Airport</button>
    <button class="wtab" onclick="tab('itin',this)"><span class="wtab-icon">🗺️</span>Itinerary</button>
    <button class="wtab" onclick="tab('corp',this)"><span class="wtab-icon">🏢</span>Corporate</button>
    <button class="wtab" onclick="tab('ai',this)"><span class="wtab-icon">💬</span>Ask AI</button>
  </div>
  <div class="wbody">

    <!-- outstation -->
    <div class="std-panel on" id="p-out">
      <div class="trip-row">
        <button class="tt on" onclick="togT(this)">One way</button>
        <button class="tt" onclick="togT(this)">Round trip</button>
      </div>
      <div class="fg fg2" style="position:relative">
        <div class="fbox"><label class="flabel">From</label><input class="fin" placeholder="Pune, Aurangabad, Mumbai…"/></div>
        <button class="swap" title="Swap">⇄</button>
        <div class="fbox"><label class="flabel">To</label><input class="fin" placeholder="Shirdi, Nashik, Goa…"/></div>
      </div>
      <div class="fg fg3">
        <div class="fbox"><label class="flabel">Date</label><input type="date" class="fin"/></div>
        <div class="fbox"><label class="flabel">Passengers</label><select class="fin"><option>1–3 pax</option><option>4–6 pax</option><option>7–12 pax</option></select></div>
        <div class="fbox"><label class="flabel">Vehicle</label><select class="fin"><option>Best match</option><option>Sedan</option><option>SUV / Innova</option><option>Luxury</option></select></div>
      </div>
      <div class="act-row">
        <button class="btn-go" onclick="ctaGate('out')">Get fare estimate</button>
        <button class="btn-wa-s" onclick="window.wa(undefined,'widget:outstation')">💬 WhatsApp</button>
      </div>
    </div>

    <!-- airport -->
    <div class="std-panel" id="p-air">
      <div class="trip-row">
        <button class="tt on" onclick="togT(this)">Pick up from airport</button>
        <button class="tt" onclick="togT(this)">Drop to airport</button>
      </div>
      <div class="fg fg2">
        <div class="fbox"><label class="flabel">Airport</label><select class="fin"><option>Aurangabad – IXU</option><option>Pune – PNQ</option><option>Mumbai – BOM</option><option>Nagpur – NAG</option><option>Hyderabad – HYD</option></select></div>
        <div class="fbox"><label class="flabel">Hotel / destination</label><input class="fin" placeholder="Area or hotel name"/></div>
      </div>
      <div class="fg fg3">
        <div class="fbox"><label class="flabel">Flight date</label><input type="date" class="fin"/></div>
        <div class="fbox"><label class="flabel">Flight time</label><input type="time" class="fin"/></div>
        <div class="fbox"><label class="flabel">Passengers</label><select class="fin"><option>1–3 pax</option><option>4–6 pax</option></select></div>
      </div>
      <div class="act-row">
        <button class="btn-go" onclick="ctaGate('air')">Check availability</button>
        <button class="btn-wa-s" onclick="window.wa(undefined,'widget:airport')">💬 WhatsApp</button>
      </div>
    </div>

    <!-- itinerary -->
    <div class="std-panel" id="p-itin">
      <p style="font-size:13.5px;color:var(--t2);line-height:1.65;margin-bottom:16px">Describe your trip. We'll plan the route, suggest stops, and send the full itinerary + fare to your WhatsApp — usually in 2 minutes.</p>
      <div class="fg fg2">
        <div class="fbox"><label class="flabel">Starting from</label><input class="fin" placeholder="Your city"/></div>
        <div class="fbox"><label class="flabel">Travel date</label><input type="date" class="fin"/></div>
      </div>
      <div class="fg" style="grid-template-columns:1fr">
        <div class="fbox"><label class="flabel">Places to visit (in order)</label><input class="fin" placeholder="e.g. Ajanta → Ellora → Daulatabad → Shirdi"/></div>
      </div>
      <div class="fg fg2">
        <div class="fbox"><label class="flabel">Passengers</label><input type="number" class="fin" placeholder="2" min="1"/></div>
        <div class="fbox"><label class="flabel">Nights (0 = day trip)</label><input type="number" class="fin" placeholder="0" min="0"/></div>
      </div>
      <div class="act-row"><button class="btn-go" onclick="ctaGate('itin')">Build my itinerary</button></div>
    </div>

    <!-- corporate -->
    <div class="std-panel" id="p-corp">
      <p style="font-size:13.5px;color:var(--t2);line-height:1.65;margin-bottom:16px">Monthly employee transport for offices, factories, and hospitals. Fixed billing, GPS-tracked, GST-compliant invoicing.</p>
      <div class="fg fg2">
        <div class="fbox"><label class="flabel">Company name</label><input class="fin" placeholder="Your organisation"/></div>
        <div class="fbox"><label class="flabel">City / industrial area</label><input class="fin" placeholder="Chakan, AURIC, Hadapsar…"/></div>
      </div>
      <div class="fg fg2">
        <div class="fbox"><label class="flabel">Employees needing cabs</label><select class="fin"><option>Under 10</option><option>10–30</option><option>30–100</option><option>100+</option></select></div>
        <div class="fbox"><label class="flabel">Shift type</label><select class="fin"><option>Day shift</option><option>Night shift</option><option>Both shifts</option><option>Executive travel</option></select></div>
      </div>
      <div class="act-row">
        <button class="btn-go" onclick="ctaGate('corp')">Request contract quote</button>
        <button class="btn-wa-s" onclick="window.wa('corporate')">💬 WhatsApp</button>
      </div>
    </div>

    <!-- AI chat -->
    <div class="chat-panel" id="p-ai">
      <div class="cmsgs" id="cmsgs">
        <div class="cmsg cmsg-bot"><div class="cbubble">Hi! Tell me your trip — where from, where to, and when. Or just pick a quick option below.</div></div>
        <div class="cmsg cmsg-bot">
          <div class="chips">
            <button class="chip" onclick="chipSend('Pune to Shirdi this weekend, 2 people')">Pune → Shirdi weekend</button>
            <button class="chip" onclick="chipSend('Aurangabad to Ajanta Ellora day trip')">Ajanta &amp; Ellora day trip</button>
            <button class="chip" onclick="chipSend('Airport pickup Pune PNQ tomorrow morning')">Airport pickup PNQ</button>
            <button class="chip" onclick="chipSend('Corporate transport for 40 employees in Chakan')">Corporate 40 employees</button>
          </div>
        </div>
      </div>
      <div class="cin-row">
        <input class="cin" id="cin" placeholder="Type your trip details…" onkeydown="if(event.key==='Enter')send()"/>
        <button class="csend" onclick="send()">
          <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  import { track } from '../lib/tracker';

  declare global {
    interface Window {
      tab: (id: string, btn: HTMLElement | null) => void;
      togT: (btn: HTMLElement) => void;
      scrollW: () => void;
      send: () => void;
      chipSend: (text: string) => void;
      ctaGate: (id: string) => void;
      gate: (id: string) => void;
    }
  }

  const PANELS = ['out', 'air', 'itin', 'corp', 'ai'];
  const SEGMENT_MAP: Record<string, string> = {
    out: 'outstation',
    air: 'airport',
    itin: 'itinerary',
    corp: 'corporate',
    ai: 'ai-chat',
  };

  window.tab = function (id: string, btn: HTMLElement | null) {
    PANELS.forEach((p) => {
      const el = document.getElementById('p-' + p);
      if (el) el.classList.remove('on');
    });
    document.querySelectorAll('.wtab').forEach((t) => t.classList.remove('on'));
    const p = document.getElementById('p-' + id);
    if (p) p.classList.add('on');
    if (btn) {
      btn.classList.add('on');
    } else {
      document.querySelectorAll('.wtab').forEach((t) => {
        if (t.getAttribute('onclick')?.includes("'" + id + "'")) t.classList.add('on');
      });
    }
    window.activeTab = SEGMENT_MAP[id] || id;
    track('tab_switch', window.activeTab);
  };

  window.scrollW = function () {
    document.querySelector('.widget')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  window.togT = function (b: HTMLElement) {
    b.closest('.trip-row')
      ?.querySelectorAll('.tt')
      .forEach((x) => x.classList.remove('on'));
    b.classList.add('on');
  };

  // Primary widget CTAs track gate_opened before handing off to the modal's
  // own gate() (defined by LeadGateModal), which owns the open/close/submit UI.
  window.ctaGate = function (id: string) {
    track('gate_opened', window.activeTab);
    window.gate(id);
  };

  const BOT: Record<string, string> = {
    shirdi:
      'Shirdi is our most-booked route. From Pune: ~190 km, 3.5 hrs, Sedan starts at ₹2,800. From Aurangabad: ~130 km, 2.5 hrs, from ₹1,900. Want a fare sent to your WhatsApp?',
    pune: 'Pune is our busiest hub. Where are you headed from Pune — Shirdi, Mahabaleshwar, Nashik, Aurangabad, or further?',
    mumbai: 'Mumbai–Pune is ~3 hrs via expressway (₹2,200+). Mumbai–Goa is ~9 hrs (₹7,500+). Which route are you thinking?',
    goa: 'Goa trip! Best started overnight from Mumbai or Pune. We can route via the coast for scenic stops. Full quote on WhatsApp in 2 minutes?',
    aurangabad: 'Aurangabad is our home base — Ajanta, Ellora, Shirdi, all covered. Where are you headed from here?',
    ajanta:
      "Ajanta day trip: from Aurangabad it's ~100 km (2 hrs one way), from ₹1,500. We can combine with Ellora for a full heritage day. Want a plan on WhatsApp?",
    airport: 'For airport transfers we track your flight live — driver adjusts automatically. Which airport, and what\'s your destination?',
    corporate:
      'Corporate contracts are our strongest product — fixed monthly billing, GPS tracking, GST invoicing. How many employees and which city/industrial area?',
    default:
      "Got it. To get you an accurate quote, I need your WhatsApp number — we'll send the full itinerary and fare in under 2 minutes. Want me to send it now?",
  };

  function getR(m: string): string {
    const ml = m.toLowerCase();
    for (const k of Object.keys(BOT)) {
      if (ml.includes(k)) return BOT[k];
    }
    return BOT.default;
  }

  function addMsg(t: string, who: 'bot' | 'user') {
    const el = document.getElementById('cmsgs');
    if (!el) return;
    const d = document.createElement('div');
    d.className = 'cmsg cmsg-' + who;
    d.innerHTML = '<div class="cbubble"></div>';
    d.querySelector('.cbubble')!.textContent = t;
    el.appendChild(d);
    el.scrollTop = el.scrollHeight;
  }

  window.send = function () {
    const i = document.getElementById('cin') as HTMLInputElement | null;
    const v = i?.value.trim();
    if (!v || !i) return;
    addMsg(v, 'user');
    i.value = '';

    const firstFive = v.split(/\s+/).slice(0, 5).join(' ');
    track('chat_used', firstFive);

    const cmsgs = document.getElementById('cmsgs');
    const tEl = document.createElement('div');
    tEl.className = 'cmsg cmsg-typing';
    tEl.id = 'typing';
    tEl.innerHTML = '<div class="cbubble">Typing…</div>';
    cmsgs?.appendChild(tEl);
    if (cmsgs) cmsgs.scrollTop = 9999;

    setTimeout(() => {
      document.getElementById('typing')?.remove();
      addMsg(getR(v), 'bot');
      setTimeout(() => {
        const d = document.createElement('div');
        d.className = 'cmsg cmsg-bot';
        d.innerHTML =
          '<div class="chips"><button class="chip" onclick="ctaGate(\'out\')">Get WhatsApp quote</button><button class="chip" onclick="ctaGate(\'itin\')">Build full itinerary</button></div>';
        cmsgs?.appendChild(d);
        if (cmsgs) cmsgs.scrollTop = 9999;
      }, 500);
    }, 850);
  };

  window.chipSend = function (t: string) {
    const i = document.getElementById('cin') as HTMLInputElement | null;
    if (i) i.value = t;
    window.send();
  };
</script>

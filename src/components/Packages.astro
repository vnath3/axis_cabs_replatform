---
---
<section class="sec pkg-sec" id="packages">
  <div class="sec-wrap">
    <div class="pkg-header">
      <div>
        <div class="kicker">Curated packages</div>
        <div class="h2">Cab + hotel + tickets,<br>sorted in one booking</div>
      </div>
      <a class="see-all" onclick="gate('itin')">View all packages →</a>
    </div>
    <div class="pkg-grid">
      <div class="pkg" onclick="pkgClick('Ajanta & Ellora Caves')">
        <div class="pkg-img img-heritage">
          <!-- Ajanta cave pillars silhouette -->
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:.35" viewBox="0 0 280 160" preserveAspectRatio="none"><rect x="20" y="60" width="18" height="100" fill="#C9A227"/><rect x="50" y="45" width="22" height="115" fill="#B8911F"/><rect x="85" y="55" width="18" height="105" fill="#C9A227"/><rect x="116" y="40" width="24" height="120" fill="#D4AF37"/><rect x="153" y="50" width="18" height="110" fill="#B8911F"/><rect x="184" y="62" width="20" height="98" fill="#C9A227"/><rect x="217" y="48" width="22" height="112" fill="#D4AF37"/><rect x="248" y="58" width="18" height="102" fill="#B8911F"/><rect x="0" y="95" width="280" height="65" fill="rgba(0,0,0,.35)"/><ellipse cx="140" cy="22" rx="90" ry="18" fill="rgba(245,158,11,.06)"/></svg>
          <span class="pkg-emoji">🏛️</span><span class="pkg-cat">Heritage</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Ajanta &amp; Ellora Caves</div>
          <div class="pkg-meta">2 days · 1 night · departing from Aurangabad</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Hotel</span><span class="pkg-tag">Entry tickets</span><span class="pkg-tag">Guide</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹8,999</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Ajanta & Ellora','package:Ajanta & Ellora')">💬</button></div>
        </div>
      </div>
      <div class="pkg" onclick="pkgClick('Shirdi Darshan')">
        <div class="pkg-img img-pilgrim">
          <!-- Shirdi dome silhouette -->
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:.4" viewBox="0 0 280 160" preserveAspectRatio="none"><ellipse cx="140" cy="55" rx="48" ry="52" fill="rgba(255,215,100,.15)"/><rect x="110" y="90" width="60" height="70" fill="rgba(255,215,100,.12)"/><rect x="92" y="108" width="96" height="52" fill="rgba(255,215,100,.1)"/><rect x="126" y="36" width="4" height="20" fill="rgba(255,215,100,.5)"/><ellipse cx="128" cy="34" rx="6" ry="4" fill="rgba(255,215,100,.45)"/><rect x="0" y="130" width="280" height="30" fill="rgba(0,0,0,.4)"/><ellipse cx="140" cy="10" rx="60" ry="12" fill="rgba(251,191,36,.08)"/></svg>
          <span class="pkg-emoji">🙏</span><span class="pkg-cat">Pilgrimage</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Shirdi Darshan</div>
          <div class="pkg-meta">Same-day return · from Pune or Aurangabad</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Darshan assist</span><span class="pkg-tag">Early start</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹4,999</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Shirdi','package:Shirdi')">💬</button></div>
        </div>
      </div>
      <div class="pkg" onclick="pkgClick('Goa Coastal')">
        <div class="pkg-img img-beach">
          <!-- Ocean horizon + palm silhouette -->
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:.45" viewBox="0 0 280 160" preserveAspectRatio="none"><rect x="0" y="88" width="280" height="72" fill="rgba(0,120,180,.25)"/><rect x="0" y="100" width="280" height="60" fill="rgba(0,80,140,.3)"/><path d="M0 88 Q70 76 140 88 Q210 100 280 88 L280 160 L0 160Z" fill="rgba(0,100,160,.2)"/><line x1="0" y1="88" x2="280" y2="88" stroke="rgba(100,200,255,.2)" stroke-width="1"/><rect x="218" y="40" width="5" height="50" fill="rgba(255,255,255,.15)"/><path d="M223 40 Q245 50 230 65 Q250 55 223 70" fill="rgba(255,255,255,.12)"/><path d="M218 50 Q196 58 208 72 Q192 62 218 74" fill="rgba(255,255,255,.1)"/><circle cx="50" cy="25" r="16" fill="rgba(255,200,50,.18)"/></svg>
          <span class="pkg-emoji">🏖️</span><span class="pkg-cat">Beach</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Goa Coastal</div>
          <div class="pkg-meta">4 days · 3 nights · from Pune or Mumbai</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Hotel</span><span class="pkg-tag">Beach drives</span><span class="pkg-tag">Sightseeing</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹17,999</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Goa','package:Goa')">💬</button></div>
        </div>
      </div>
      <div class="pkg" onclick="pkgClick('Mahabaleshwar')">
        <div class="pkg-img img-hills">
          <!-- Layered mountain silhouette -->
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:.5" viewBox="0 0 280 160" preserveAspectRatio="none"><polygon points="0,160 80,55 160,160" fill="rgba(255,255,255,.04)"/><polygon points="60,160 160,35 260,160" fill="rgba(255,255,255,.06)"/><polygon points="120,160 220,60 280,90 280,160" fill="rgba(255,255,255,.04)"/><polygon points="0,160 0,100 50,75 100,100 60,160" fill="rgba(0,0,0,.2)"/><rect x="0" y="130" width="280" height="30" fill="rgba(0,0,0,.35)"/><polygon points="140,35 148,50 132,50" fill="rgba(255,255,255,.25)"/></svg>
          <span class="pkg-emoji">⛰️</span><span class="pkg-cat">Hill station</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Mahabaleshwar</div>
          <div class="pkg-meta">2 days · 1 night · from Pune</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Hotel</span><span class="pkg-tag">Mapro factory</span><span class="pkg-tag">Viewpoints</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹7,499</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Mahabaleshwar','package:Mahabaleshwar')">💬</button></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from '../lib/tracker';

  declare global {
    interface Window {
      pkgClick: (name: string) => void;
    }
  }

  window.pkgClick = function (name: string) {
    track('package_clicked', name);
    window.gate('itin');
  };
</script>

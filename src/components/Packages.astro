---
import WaIcon from './WaIcon.astro';
---
<section class="sec pkg-sec" id="packages">
  <div class="sec-wrap">
    <div class="pkg-header">
      <div>
        <div class="kicker">Curated packages</div>
        <div class="h2">Cab + hotel + tickets,<br>sorted in one booking</div>
      </div>
      <a class="see-all" onclick="gate('itin')">View all packages →</a>
    </div>
    <div class="pkg-grid">
      <div class="pkg" onclick="pkgClick('Ajanta & Ellora Caves')">
        <div class="pkg-img img-heritage">
          <img src="/images/packages/ajanta-ellora.jpg" alt="Ajanta &amp; Ellora Caves" loading="lazy" />
          <span class="pkg-cat">Heritage</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Ajanta &amp; Ellora Caves</div>
          <div class="pkg-meta">2 days · 1 night · departing from Aurangabad</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Hotel</span><span class="pkg-tag">Entry tickets</span><span class="pkg-tag">Guide</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹8,999</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Ajanta & Ellora','package:Ajanta & Ellora')"><WaIcon size={18} /></button></div>
        </div>
      </div>
      <div class="pkg" onclick="pkgClick('Shirdi Darshan')">
        <div class="pkg-img img-pilgrim">
          <img src="/images/packages/shirdi.jpg" alt="Shirdi Darshan" loading="lazy" />
          <span class="pkg-cat">Pilgrimage</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Shirdi Darshan</div>
          <div class="pkg-meta">Same-day return · from Pune or Aurangabad</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Darshan assist</span><span class="pkg-tag">Early start</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹4,999</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Shirdi','package:Shirdi')"><WaIcon size={18} /></button></div>
        </div>
      </div>
      <div class="pkg" onclick="pkgClick('Goa Coastal')">
        <div class="pkg-img img-beach">
          <img src="/images/packages/goa.jpg" alt="Goa Coastal" loading="lazy" />
          <span class="pkg-cat">Beach</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Goa Coastal</div>
          <div class="pkg-meta">4 days · 3 nights · from Pune or Mumbai</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Hotel</span><span class="pkg-tag">Beach drives</span><span class="pkg-tag">Sightseeing</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹17,999</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Goa','package:Goa')"><WaIcon size={18} /></button></div>
        </div>
      </div>
      <div class="pkg" onclick="pkgClick('Mahabaleshwar')">
        <div class="pkg-img img-hills">
          <img src="/images/packages/mahabaleshwar.jpg" alt="Mahabaleshwar" loading="lazy" />
          <span class="pkg-cat">Hill station</span>
        </div>
        <div class="pkg-body">
          <div class="pkg-name">Mahabaleshwar</div>
          <div class="pkg-meta">2 days · 1 night · from Pune</div>
          <div class="pkg-tags"><span class="pkg-tag">Cab</span><span class="pkg-tag">Hotel</span><span class="pkg-tag">Mapro factory</span><span class="pkg-tag">Viewpoints</span></div>
          <div class="pkg-foot"><div><div class="pkg-label">from</div><div class="pkg-price">₹7,499</div></div><button class="pkg-wa" onclick="event.stopPropagation();window.wa('Mahabaleshwar','package:Mahabaleshwar')"><WaIcon size={18} /></button></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from '../lib/tracker';

  declare global {
    interface Window {
      pkgClick: (name: string) => void;
    }
  }

  window.pkgClick = function (name: string) {
    track('package_clicked', name);
    window.gate('itin');
  };
</script>

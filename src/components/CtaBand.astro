---
import WaIcon from './WaIcon.astro';
---
<div class="cta-band">
  <div class="cta-band-wrap">
    <div>
      <div class="cta-h">Your driver is a WhatsApp message away.</div>
      <p class="cta-p">Tell us where you're going. Fixed fare back in 2 minutes. No commitment until you say yes.</p>
    </div>
    <div class="cta-acts">
      <button class="btn-cta-wa" onclick="window.wa(undefined,'cta-band')"><WaIcon size={20} /> Chat on WhatsApp</button>
    </div>
  </div>
</div>

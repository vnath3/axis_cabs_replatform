---
import WaIcon from './WaIcon.astro';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="footer-logo">
        <div class="footer-logo-mark" style="background:transparent">
          <svg viewBox="0 0 64 64" width="32" height="32">
            <rect width="64" height="64" rx="16" fill="#08192E"/>
            <line x1="18" y1="48" x2="32" y2="16" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
            <line x1="46" y1="48" x2="32" y2="16" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
            <line x1="23.5" y1="36" x2="40.5" y2="36" stroke="#60A5FA" stroke-width="3" stroke-linecap="round" stroke-dasharray="3 4"/>
            <circle cx="32" cy="16" r="4.5" fill="#2563EB" stroke="#08192E" stroke-width="1.5"/>
          </svg>
        </div>
        <span class="footer-logo-text">Axis<span>Cabs</span></span>
      </div>
      <p class="footer-tagline">We started Axis Cabs because we were tired of cab services that made promises they couldn't keep at 4am. Fixed fares. A driver who calls first. A coordinator who picks up. Every time.</p>
      <div class="footer-contact">
        <a onclick="window.wa(undefined,'footer')"><WaIcon size={16} /> Chat on WhatsApp</a>
        <span class="footer-phone"><Icon name="phone" size={16} /> +91 99223 33305</span>
        <a href="mailto:hello@axiscabs.com"><Icon name="mail" size={16} /> hello@axiscabs.com</a>
        <a><Icon name="map-pin" size={16} /> Chhatrapati Sambhaji Nagar, Maharashtra</a>
      </div>
    </div>
    <div class="fcol">
      <h4>Services</h4>
      <ul>
        <li><a href="#">Outstation cabs</a></li>
        <li><a href="#">Airport transfers</a></li>
        <li><a href="#">Multi-stop itinerary</a></li>
        <li><a href="#">Corporate contracts</a></li>
        <li><a href="#">Tour packages</a></li>
      </ul>
    </div>
    <div class="fcol">
      <h4>Top routes</h4>
      <ul>
        <li><a href="#">Pune to Shirdi cab</a></li>
        <li><a href="#">Mumbai to Pune cab</a></li>
        <li><a href="#">Aurangabad to Ajanta</a></li>
        <li><a href="#">Pune to Goa cab fare</a></li>
        <li><a href="#">Nagpur to Aurangabad</a></li>
      </ul>
    </div>
    <div class="fcol">
      <h4>Company</h4>
      <ul>
        <li><a href="#">About Axis Cabs</a></li>
        <li><a href="#">Travel blog</a></li>
        <li><a href="#">Hidden gems</a></li>
        <li><a href="#">Drive with us</a></li>
        <li><a href="#">Privacy policy</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Axis Cabs · Registered in Maharashtra, India</p>
    <p>Designed in Chhatrapati Sambhaji Nagar · Built for travellers who value clarity over promises.</p>
  </div>
</footer>
